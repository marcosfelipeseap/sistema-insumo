<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Simulador de Produção - Satre</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .sim-container { display: flex; flex-direction: column; gap: 30px; }
        .sim-form-area { width: 100%; background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; border-top: 4px solid #8b5cf6; }
        .sim-result-area { width: 100%; display: none; }
        
        .produto-row { display: flex; gap: 10px; margin-bottom: 20px; align-items: flex-start; padding: 20px; background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; }
        .input-sim { padding: 12px 15px; border: 1px solid #cbd5e1; border-radius: 8px; outline: none; background: #fff; font-size: 1rem; width: 100%; transition: 0.2s; }
        .input-sim:focus { border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.1); }
        
        .custom-dropdown { position: relative; width: 100%; }
        .dropdown-icon { position: absolute; left: 15px; top: 15px; color: #94a3b8; pointer-events: none; }
        .dropdown-search { padding-left: 40px; }
        .dropdown-list { display: none; position: absolute; top: 100%; left: 0; width: 100%; max-height: 250px; overflow-y: auto; background: white; border: 1px solid #cbd5e1; border-radius: 8px; margin-top: 5px; z-index: 1000; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .dropdown-item { padding: 12px 15px; cursor: pointer; border-bottom: 1px solid #f1f5f9; transition: background 0.2s; }
        .dropdown-item:hover { background: #f8fafc; }
        .badge-processo { background: #dcfce3; color: #166534; padding: 4px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; border: 1px solid #bbf7d0; display: inline-flex; align-items: center; gap: 4px; }
        
        .result-card { background: white; padding: 25px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; margin-bottom: 20px; }
        .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .summary-box { padding: 20px; border-radius: 10px; color: white; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: 0.3s; }
        .summary-box h4 { font-size: 0.95rem; font-weight: 600; margin-bottom: 5px; opacity: 0.9; text-transform: uppercase; letter-spacing: 0.5px; }
        .summary-box h2 { font-size: 1.8rem; font-weight: 700; }
        
        .table-custom { width: 100%; border-collapse: collapse; }
        .table-custom th, .table-custom td { padding: 14px 15px; border-bottom: 1px solid #e2e8f0; text-align: left; font-size: 0.95rem; }
        .table-custom th { background-color: #f1f5f9; color: #475569; font-weight: bold; text-transform: uppercase; position: sticky; top: 0; box-shadow: 0 2px 0 0 #cbd5e1; z-index: 10; }
    </style>
</head>
<body>
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
        <div class="page-header" style="margin-bottom: 25px;">
            <div>
                <h1>Simulador de Produção (MRP)</h1>
                <p style="color: #64748b; font-size: 1.1rem; margin-top: 5px;">Calcule necessidades e analise viabilidade desmarcando insumos da lista se necessário.</p>
            </div>
        </div>

        <div class="sim-container">
            
            <!-- ÁREA DE ESCOLHA DOS PRODUTOS -->
            <div class="sim-form-area">
                <h3 style="color: #0f172a; margin-bottom: 20px; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-list-ol" style="color:#8b5cf6;"></i> Escolha dos Produtos
                </h3>
                
                <div id="produtosContainer"></div>

                <button type="button" class="btn" style="background: #f1f5f9; color: #334155; border: 1px dashed #94a3b8; width: 100%; margin-bottom: 20px; padding: 12px; font-weight: bold;" onclick="adicionarLinha()">
                    <i class="fas fa-plus"></i> Adicionar Outro Produto
                </button>

                <button type="button" id="btnSimular" class="btn" style="background: #8b5cf6; color: white; width: 100%; padding: 15px; font-size: 1.1rem; font-weight: bold; border-radius: 8px; box-shadow: 0 4px 6px rgba(139, 92, 246, 0.3);" onclick="executarSimulacao()">
                    <i class="fas fa-play-circle"></i> Executar Simulação
                </button>
            </div>

            <!-- ÁREA DOS RESULTADOS -->
            <div class="sim-result-area" id="areaResultados">
                
                <div class="summary-grid">
                    <div class="summary-box" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <h4>Viabilidade Atual</h4>
                        <h2 id="resPercent">0%</h2>
                    </div>
                    <div class="summary-box" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                        <h4>Custo Previsto (Produção)</h4>
                        <h2 id="resCustoTotal">R$ 0,00</h2>
                    </div>
                    <div class="summary-box" style="background: linear-gradient(135deg, #0ea5e9, #0284c7);">
                        <h4>Estoque Disponível (Valor)</h4>
                        <h2 id="resCustoEstoque">R$ 0,00</h2>
                    </div>
                    <div class="summary-box" style="background: linear-gradient(135deg, #ef4444, #dc2626);">
                        <h4>Custo Faltante (Comprar)</h4>
                        <h2 id="resCustoFalta">R$ 0,00</h2>
                    </div>
                </div>

                <div class="result-card">
                    <h3 style="color: #0f172a; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid #e2e8f0;">
                        <i class="fas fa-box-open" style="color: #10b981;"></i> Produtos: Projeção de Fabricação
                    </h3>
                    <table class="table-custom" style="margin-bottom: 10px;">
                        <thead><tr><th>Produto Desejado</th><th style="text-align:center;">Qtd Solicitada</th><th style="text-align:center; color:#059669;">É Possível Fazer:</th></tr></thead>
                        <tbody id="tbProjecoes"></tbody>
                    </table>
                </div>

                <div class="result-card" style="padding: 0; overflow: hidden;">
                    <div style="padding: 25px 25px 15px 25px; border-bottom: 1px solid #e2e8f0;">
                        <h3 style="color: #0f172a; margin: 0;">
                            <i class="fas fa-cubes" style="color: #f59e0b;"></i> Insumos: Necessidades vs Estoque
                        </h3>
                    </div>
                    <div style="max-height: 50vh; overflow-y: auto;">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th style="text-align:center; width: 5%;">
                                        <input type="checkbox" id="checkAll" checked onclick="toggleAll(this)" style="transform: scale(1.3); cursor:pointer;">
                                    </th>
                                    <th style="width: 35%;">Insumo Físico</th>
                                    <th style="text-align:right;">Necessário</th>
                                    <th style="text-align:right;">Tem no Estoque</th>
                                    <th style="text-align:right; color:#0284c7;">Valor (Estoque)</th>
                                    <th style="text-align:right; color:#ef4444;">Falta Comprar</th>
                                </tr>
                            </thead>
                            <tbody id="tbInsumos"></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <!-- TEMPLATE OCULTO PARA OS DROPDOWNS -->
    <div id="templateLinha" style="display: none;">
        <div class="produto-row">
            <div style="flex: 3;">
                <label style="display:block; font-weight:bold; color:#475569; margin-bottom:8px; font-size:0.85rem;">Pesquise e Escolha o Produto</label>
                <div class="custom-dropdown">
                    <i class="fas fa-search dropdown-icon"></i>
                    <input type="text" class="input-sim dropdown-search" placeholder="Ex: Cadeira Escolar..." onfocus="mostrarOpcoes(this)" onkeyup="filtrarOpcoes(this)">
                    <input type="hidden" class="prod-id-value">
                    <div class="dropdown-list">
                        <% produtos.forEach(p => { %>
                            <div class="dropdown-item" data-id="<%= p.id %>" data-nome="<%= p.nome.toLowerCase() %>" onclick="selecionarProduto(this)">
                                <div style="font-weight: bold; color: #1e293b; font-size: 0.95rem;"><%= p.nome %></div>
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 5px;">
                                    <span style="font-size: 0.8rem; color: #64748b;"><i class="fas fa-layer-group"></i> <%= p.grupo %></span>
                                    <% if(p.em_uso) { %>
                                        <span class="badge-processo"><i class="fas fa-fire"></i> Mais Pedido (Ativo)</span>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
            <div style="flex: 1;">
                <label style="display:block; font-weight:bold; color:#475569; margin-bottom:8px; font-size:0.85rem;">Quantidade</label>
                <input type="number" class="input-sim prod-qtd" min="1" value="1">
            </div>
            <button type="button" class="btn" style="background:#ef4444; color:white; padding:12px; margin-top: 25px; border-radius: 8px;" onclick="removerLinha(this)" title="Remover"><i class="fas fa-trash"></i></button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => adicionarLinha());

        function mostrarOpcoes(input) {
            const list = input.nextElementSibling.nextElementSibling; 
            document.querySelectorAll('.dropdown-list').forEach(l => { if(l !== list) l.style.display = 'none'; });
            list.style.display = 'block';
        }

        function filtrarOpcoes(input) {
            const term = input.value.toLowerCase();
            const list = input.nextElementSibling.nextElementSibling;
            list.style.display = 'block';
            
            const items = list.querySelectorAll('.dropdown-item');
            items.forEach(item => {
                if(item.getAttribute('data-nome').includes(term)) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function selecionarProduto(itemElement) {
            const id = itemElement.getAttribute('data-id');
            const nome = itemElement.querySelector('div').innerText;
            
            const container = itemElement.closest('.custom-dropdown');
            const inputSearch = container.querySelector('.dropdown-search');
            const hiddenVal = container.querySelector('.prod-id-value');
            const list = container.querySelector('.dropdown-list');
            
            inputSearch.value = nome;
            hiddenVal.value = id;
            list.style.display = 'none';
            inputSearch.style.borderColor = '#10b981'; 
        }

        document.addEventListener('click', function(e) {
            if(!e.target.classList.contains('dropdown-search')) {
                document.querySelectorAll('.dropdown-list').forEach(l => l.style.display = 'none');
            }
        });

        function adicionarLinha() {
            const template = document.getElementById('templateLinha').innerHTML;
            document.getElementById('produtosContainer').insertAdjacentHTML('beforeend', template);
        }

        function removerLinha(btn) {
            const linhas = document.querySelectorAll('#produtosContainer .produto-row');
            if (linhas.length > 1) {
                btn.closest('.produto-row').remove();
            } else {
                alert("Você precisa ter pelo menos um produto na simulação.");
            }
        }

        let dadosSimulacao = null;

        const formatarMoeda = (valor) => Number(valor).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

        async function executarSimulacao() {
            const linhas = document.querySelectorAll('#produtosContainer .produto-row');
            const itens = [];
            
            linhas.forEach(linha => {
                const pId = linha.querySelector('.prod-id-value').value;
                const qtd = linha.querySelector('.prod-qtd').value;
                if (pId && qtd > 0) itens.push({ produto_id: pId, quantidade: qtd });
            });

            if (itens.length === 0) return alert("Selecione os produtos da lista antes de simular.");

            const btn = document.getElementById('btnSimular');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processando...';
            btn.disabled = true;

            try {
                const response = await fetch('/simulador/calcular', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ itens })
                });
                
                const result = await response.json();
                if (result.erro) throw new Error(result.erro);

                renderizarTabela(result);
            } catch (error) {
                alert(error.message);
            } finally {
                btn.innerHTML = '<i class="fas fa-play-circle"></i> Executar Simulação';
                btn.disabled = false;
            }
        }

        function renderizarTabela(dados) {
            dadosSimulacao = dados;
            document.getElementById('areaResultados').style.display = 'block';

            const tbInsumos = document.getElementById('tbInsumos');
            tbInsumos.innerHTML = '';
            
            // Ordenação Alfabética dos insumos A-Z garantida aqui!
            dados.insumos.sort((a, b) => a.descricao.localeCompare(b.descricao));
            
            dados.insumos.forEach(ins => {
                const corFalta = ins.qtd_falta > 0 ? '#ef4444' : '#64748b';
                const bgLinha = ins.qtd_falta > 0 ? '#fef2f2' : 'white';
                
                tbInsumos.innerHTML += `
                    <tr style="background: ${bgLinha}; transition: 0.3s;">
                        <td style="text-align:center;">
                            <input type="checkbox" class="check-insumo" value="${ins.id}" checked onchange="recalcularDinamico()" style="transform: scale(1.3); accent-color: #8b5cf6; cursor:pointer;">
                        </td>
                        <td>
                            <strong style="color:#0f172a; font-size: 0.95rem;">${ins.descricao}</strong> <br>
                            <span style="font-size:0.8rem; color:#64748b;">UN: ${ins.unidade} | Unitário: ${formatarMoeda(ins.valor_unit)}</span>
                        </td>
                        <td style="text-align:right; font-weight:bold; color:#475569;">${ins.qtd_necessaria}</td>
                        <td style="text-align:right; color:#10b981; font-weight:bold;">${ins.qtd_estoque}</td>
                        <td style="text-align:right; color:#0284c7; font-weight:bold;">${formatarMoeda(ins.custo_estoque)}</td>
                        <td style="text-align:right; color:${corFalta}; font-weight:bold;">
                            ${ins.qtd_falta} <br>
                            <span style="font-size:0.8rem;">${formatarMoeda(ins.qtd_falta * ins.valor_unit)}</span>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('checkAll').checked = true;
            recalcularDinamico();
        }

        function toggleAll(source) {
            const checkboxes = document.querySelectorAll('.check-insumo');
            checkboxes.forEach(chk => chk.checked = source.checked);
            recalcularDinamico();
        }

        function recalcularDinamico() {
            if (!dadosSimulacao) return;

            let custoTotalNecessario = 0;
            let custoTotalEmEstoque = 0;
            let custoTotalFaltante = 0;
            let menorProporcao = Infinity;
            let temChecados = false;

            const checkboxes = document.querySelectorAll('.check-insumo');
            checkboxes.forEach(chk => {
                const tr = chk.closest('tr');
                if (chk.checked) {
                    tr.style.opacity = '1'; 
                    temChecados = true;
                    const id = chk.value;
                    const ins = dadosSimulacao.insumos.find(i => String(i.id) === String(id));
                    
                    if (ins) {
                        custoTotalNecessario += ins.custo_total;
                        custoTotalEmEstoque += ins.custo_estoque;
                        custoTotalFaltante += (ins.qtd_falta * ins.valor_unit);

                        const proporcao = ins.qtd_estoque === 0 ? 0 : ins.qtd_estoque / ins.qtd_necessaria;
                        if (proporcao < menorProporcao) menorProporcao = proporcao;
                    }
                } else {
                    tr.style.opacity = '0.4'; 
                }
            });

            if (!temChecados) {
                menorProporcao = 0;
            } else if (menorProporcao > 1) {
                menorProporcao = 1; 
            }

            document.getElementById('resPercent').innerText = (menorProporcao * 100).toFixed(1) + '%';
            document.getElementById('resCustoTotal').innerText = formatarMoeda(custoTotalNecessario);
            document.getElementById('resCustoEstoque').innerText = formatarMoeda(custoTotalEmEstoque);
            document.getElementById('resCustoFalta').innerText = formatarMoeda(custoTotalFaltante);

            const tbProjecoes = document.getElementById('tbProjecoes');
            tbProjecoes.innerHTML = '';
            dadosSimulacao.projecaoProdutos.forEach(p => {
                const possivel = Math.floor(p.qtd_solicitada * menorProporcao);
                tbProjecoes.innerHTML += `
                    <tr>
                        <td><strong style="color:#1e293b; font-size: 1.05rem;">${p.nome}</strong></td>
                        <td style="text-align:center; font-weight:bold; color:#64748b;">${p.qtd_solicitada}</td>
                        <td style="text-align:center; color:#059669; font-weight:bold; font-size:1.2rem; background: #dcfce7; border-radius: 6px;">${possivel}</td>
                    </tr>
                `;
            });
        }
    </script>
</body>
</html>