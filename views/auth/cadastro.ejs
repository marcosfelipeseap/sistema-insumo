<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro - Controle de Insumos</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { display: flex; justify-content: center; align-items: center; min-height: 100vh; background-color: #f1f5f9; padding: 2rem 0; }
        .auth-container { background: white; padding: 2.5rem 2rem; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); width: 100%; max-width: 450px; }
        
        .logo-container { text-align: center; margin-bottom: 1rem; }
        .logo-container img { width: 70px; height: auto; border-radius: 8px; }

        .auth-container h2 { text-align: center; margin-bottom: 1.5rem; color: #1e293b; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: #475569; }
        .form-group input { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
        .btn-auth { width: 100%; padding: 0.75rem; background-color: #16a34a; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-top: 1rem; }
        .btn-auth:hover { background-color: #15803d; }
        .auth-links { text-align: center; margin-top: 1rem; font-size: 0.875rem; }
        .alert-error { padding: 0.75rem; background-color: #fee2e2; color: #991b1b; border-radius: 4px; margin-bottom: 1rem; text-align: center; }
    </style>
</head>
<body>
    <div class="auth-container">
        <div class="logo-container">
            <img src="/img/logo.png" alt="Logo SEAP">
        </div>
        
        <h2>Solicitar Acesso</h2>

        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alert-error"><%= erro %></div>
        <% } %>

        <form action="/cadastro" method="POST">
            <div class="form-group">
                <label>Nome Completo</label>
                <input type="text" name="nome" required placeholder="Seu nome">
            </div>
            <div class="form-group">
                <label>Nome de Usuário</label>
                <!-- Placeholder alterado aqui -->
                <input type="text" name="usuario" required placeholder="Crie um nome de usuário para login">
            </div>
            <div class="form-group">
                <label>E-mail</label>
                <input type="email" name="email" required placeholder="seu@email.com">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="senha" required placeholder="Crie uma senha forte">
            </div>
            <button type="submit" class="btn-auth">Cadastrar</button>
        </form>
        <div class="auth-links">
            <a href="/login">Já tem uma conta? Faça login</a>
        </div>
    </div>
</body>
</html>