<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Login - Controle de Insumos</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f1f5f9; }
        .auth-container { background: white; padding: 2.5rem 2rem; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); width: 100%; max-width: 400px; }
        
        /* Estilo para centralizar a logo */
        .logo-container { text-align: center; margin-bottom: 1rem; }
        .logo-container img { width: 80px; height: auto; border-radius: 8px; }
        
        .auth-container h2 { text-align: center; margin-bottom: 1.5rem; color: #1e293b; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; color: #475569; }
        .form-group input { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
        .btn-auth { width: 100%; padding: 0.75rem; background-color: #2563eb; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin-top: 1rem; }
        .btn-auth:hover { background-color: #1d4ed8; }
        .auth-links { text-align: center; margin-top: 1rem; font-size: 0.875rem; }
        .alert { padding: 0.75rem; border-radius: 4px; margin-bottom: 1rem; text-align: center; }
        .alert-error { background-color: #fee2e2; color: #991b1b; }
        .alert-success { background-color: #dcfce3; color: #166534; }
    </style>
</head>
<body>
    <div class="auth-container">
        <!-- Logo adicionada aqui -->
        <div class="logo-container">
            <img src="/img/logo.png" alt="Logo SEAP">
        </div>
        
        <h2>Entrar no Sistema</h2>
        
        <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alert alert-error"><%= erro %></div>
        <% } %>
        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <div class="alert alert-success"><%= sucesso %></div>
        <% } %>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Email ou Usuário</label>
                <input type="text" name="login" required placeholder="Digite seu e-mail ou usuário">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" name="senha" required placeholder="Sua senha">
            </div>
            <button type="submit" class="btn-auth">Acessar</button>
        </form>
        <div class="auth-links">
            <a href="/cadastro">Não tem uma conta? Solicite acesso</a>
        </div>
    </div>
</body>
</html>