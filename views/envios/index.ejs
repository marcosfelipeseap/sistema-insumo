<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Envios para Produção</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
        <div class="page-header">
            <h1>Envios para Produção</h1>
            <p style="color:#64748b;">Selecione o processo que irá receber os insumos do almoxarifado.</p>
        </div>

        <div class="grid-cards">
            <% processos.forEach(proc => { %>
                <div class="card" style="border-top-color: #f59e0b;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                        <h3><%= proc.nome %></h3>
                        <span style="font-weight:bold; color:#64748b;">#<%= proc.numero %></span>
                    </div>
                    
                    <p>Status Atual: 
                        <span class="badge" style="background:#f1f5f9; color:#334155;"><%= proc.status %></span>
                    </p>
                    
                    <div class="card-footer">
                        <a href="/envios/<%= proc.id %>" class="btn" style="background:#f59e0b; color:white; width: 100%; text-align: center;">
                            <i class="fas fa-truck-loading"></i> Enviar Insumos
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>
</body>
</html>