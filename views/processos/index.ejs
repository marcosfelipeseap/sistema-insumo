<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Processos e Demandas - Controle de Insumos</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .progress-bar-bg { background-color: #e2e8f0; border-radius: 999px; height: 8px; width: 100%; overflow: hidden; margin-top: 6px; }
        .progress-bar-fill { height: 100%; background-color: #10b981; }
    </style>
</head>
<body>
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
        <div class="page-header">
            <h1>Processos e Demandas</h1>
            <% if (user && user.cargo !== 'Monitor') { %>
                <a href="/processos/novo" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Processo</a>
            <% } %>
        </div>

        <div class="grid-cards">
            <% processos.forEach(proc => { %>
                <div class="card">
                    <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
                        <h3><%= proc.nome %></h3>
                        <span style="font-weight:bold; color:#64748b;">#<%= proc.numero %></span>
                    </div>
                    
                    <% 
                        let statusTexto = proc.status || 'Aprovado';
                        let bgCor = '#10b981'; 
                        let icone = 'fa-check-circle';
                        if (statusTexto === 'Pendente') { bgCor = '#f59e0b'; icone = 'fa-clock'; }
                        if (statusTexto === 'Recusado') { bgCor = '#ef4444'; icone = 'fa-times-circle'; }
                    %>
                    <p style="display:flex; justify-content:space-between; align-items:center;">
                        <span style="background: <%= bgCor %>; color: white; padding: 4px 8px; border-radius: 4px; font-size: 0.85rem; font-weight: bold;">
                            <i class="fas <%= icone %>"></i> <%= statusTexto %>
                        </span>
                    </p>

                    <p style="margin-top:10px;"><i class="fas fa-box"></i> <%= proc.qtd_produtos %> Produtos Vinculados</p>
                    
                    <!-- BARRA DE PROGRESSO NO INDEX -->
                    <div style="margin-top: 12px; background: #f8fafc; padding: 10px; border-radius: 6px; border: 1px solid #e2e8f0;">
                        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; font-weight: bold; color: #334155;">
                            <span>Progresso de Entrega</span>
                            <span><%= proc.percentual_conclusao %>%</span>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" style="width: <%= proc.percentual_conclusao %>%; background-color: <%= proc.percentual_conclusao === 100 ? '#10b981' : '#3b82f6' %>;"></div>
                        </div>
                    </div>

                    <div class="card-footer" style="flex-wrap: wrap; gap: 10px; margin-top: 15px;">
                        <a href="/processos/<%= proc.id %>/detalhes" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.85rem;"><i class="fas fa-eye"></i> Detalhes</a>
                        
                        <% if (user && (user.cargo === 'admin' || user.cargo === 'Coordenador')) { %>
                            <a href="/estoque/processo/<%= proc.id %>/separacao" class="btn" style="background: #10b981; color: white; padding: 6px 12px; font-size: 0.85rem;"><i class="fas fa-boxes"></i> Separar Material</a>
                        <% } %>
                        
                        <% if (user && user.cargo === 'admin') { %>
                            <div style="display: flex; gap: 5px;">
                                <a href="/processos/<%= proc.id %>/editar" class="btn" style="background: #f59e0b; color: white; padding: 6px 10px; font-size: 0.85rem;"><i class="fas fa-edit"></i></a>
                                <form action="/processos/<%= proc.id %>/deletar" method="POST" style="display:inline;" onsubmit="return confirm('Tem certeza que deseja apagar TUDO deste processo (inclusive estoque e movimentações)?');">
                                    <button type="submit" class="btn" style="background: #ef4444; color: white; padding: 6px 10px; font-size: 0.85rem;"><i class="fas fa-trash"></i></button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
            
            <% if(processos.length === 0) { %>
                <p style="grid-column: 1 / -1; text-align: center; color: #64748b;">Nenhum processo ou demanda encontrado.</p>
            <% } %>
        </div>
    </main>
</body>
</html>