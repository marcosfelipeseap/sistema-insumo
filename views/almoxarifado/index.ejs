<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Almoxarifado Sede (Marcenaria)</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .tabs-container { display: flex; gap: 10px; border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; overflow-x: auto; }
        .tab-btn { padding: 12px 20px; background: transparent; border: none; font-size: 1.05rem; font-weight: 600; color: #64748b; cursor: pointer; transition: 0.2s; border-bottom: 3px solid transparent; margin-bottom: -2px; white-space: nowrap; }
        .tab-btn:hover { color: #2563eb; }
        .tab-btn.active { color: #2563eb; border-bottom-color: #2563eb; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 25px; }
        .summary-card { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 15px; }
        .summary-icon { width: 50px; height: 50px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: white; }
        .summary-info h4 { margin: 0; font-size: 0.9rem; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; }
        .summary-info .value { margin: 0; font-size: 1.6rem; font-weight: 700; color: #0f172a; }

        .filter-panel { background: #f8fafc; border-radius: 8px; margin-bottom: 20px; border: 1px solid #cbd5e1; padding: 15px; display: flex; gap: 20px; flex-wrap: wrap; }
        .dropdown-check-list { display: inline-block; width: 100%; position: relative; }
        .dropdown-check-list .anchor { width: 100%; padding: 12px 16px; background: white; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: #334155; font-weight: 500; }
        .dropdown-check-list .items-container { display: none; position: absolute; width: 100%; background: white; border: 1px solid #cbd5e1; z-index: 100; margin-top: -1px; border-radius: 0 0 6px 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .dropdown-check-list.visible .items-container { display: block; }
        .items-container .search-dd { width: 100%; padding: 12px; border: none; border-bottom: 1px solid #e2e8f0; outline: none; background: #f8fafc; }
        .items-container ul { list-style: none; margin: 0; padding: 0; max-height: 250px; overflow-y: auto; }
        .items-container ul li { padding: 10px 15px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; gap: 10px; }
        .items-container ul li:hover { background: #f8fafc; }
        .items-container ul li input { transform: scale(1.1); cursor: pointer; }
        
        .card-panel { background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e2e8f0; }
        .table-responsive { width: 100%; overflow-x: auto; }
        .table-custom { width: 100%; border-collapse: collapse; }
        .table-custom th, .table-custom td { padding: 14px 16px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: middle; }
        .table-custom th { background-color: #f8fafc; color: #475569; font-weight: 700; text-transform: uppercase; font-size: 0.75rem; }
        .table-custom td { color: #1e293b; font-size: 0.95rem; }
        
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; padding-bottom: 15px; border-bottom: 1px solid #e2e8f0; }
        .btn-voltar { background: #e2e8f0; color: #334155; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }
        .btn-voltar:hover { background: #cbd5e1; }

        .badge-local-sede { background: #dbeafe; color: #1e40af; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 0.8rem; }
        .badge-local-regional { background: #fef08a; color: #854d0e; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 0.8rem; }
        .badge-local-upfem { background: #fce7f3; color: #9d174d; padding: 3px 8px; border-radius: 4px; font-weight: 600; font-size: 0.8rem; }
    </style>
</head>
<body style="display: block;"> 
    
    <main class="main-content" style="max-width: 1400px; margin: 0 auto;">
        <div class="page-header">
            <div>
                <h1 style="margin: 0; font-size: 1.8rem; color: #0f172a;">
                    <i class="fas fa-warehouse" style="color: #2563eb; margin-right: 10px;"></i> Almoxarifado Integrado
                </h1>
                <p style="color:#64748b; font-size: 1.05rem; margin-top: 5px; margin-bottom: 0;">Consulta direta da Planilha Google (Sede, Regional e UPFEM).</p>
            </div>
            <a href="/estoque" class="btn-voltar"><i class="fas fa-arrow-left"></i> Voltar para Controle de Insumos</a>
        </div>

        <div class="summary-grid">
            <div class="summary-card">
                <div class="summary-icon" style="background: #3b82f6;"><i class="fas fa-boxes"></i></div>
                <div class="summary-info">
                    <h4>Total de Itens Físicos</h4>
                    <p class="value" id="resumoQtd">0</p>
                </div>
            </div>
            <div class="summary-card">
                <div class="summary-icon" style="background: #10b981;"><i class="fas fa-dollar-sign"></i></div>
                <div class="summary-info">
                    <h4>Valor Total em Estoque</h4>
                    <p class="value" id="resumoValor">R$ 0,00</p>
                </div>
            </div>
        </div>

        <div class="tabs-container">
            <button class="tab-btn active" onclick="switchTab('mdf')">MDF e Fitas</button>
            <button class="tab-btn" onclick="switchTab('ferragens')">Ferragens</button>
            <button class="tab-btn" onclick="switchTab('limpeza')">Limpeza</button>
            <button class="tab-btn" onclick="switchTab('epis')">EPI's</button>
            <button class="tab-btn" onclick="switchTab('maquinario')">Maquinário</button>
        </div>

        <!-- ABA 1: MDF -->
        <div id="tab-mdf" class="tab-content active">
            <div class="filter-panel">
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Local:</p>
                    <div id="dd-mdf-local" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-mdf-local')">
                            <span id="title-mdf-local" style="color: #2563eb; font-weight: bold;">Selecione os locais...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container">
                            <input type="text" class="search-dd" placeholder="🔍 Pesquisar...">
                            <ul id="list-mdf-local"></ul>
                        </div>
                    </div>
                </div>
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Insumo:</p>
                    <div id="dd-mdf-insumo" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-mdf-insumo')">
                            <span id="title-mdf-insumo" style="color: #2563eb; font-weight: bold;">Selecione os insumos...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container">
                            <input type="text" class="search-dd" placeholder="🔍 Pesquisar...">
                            <ul id="list-mdf-insumo"></ul>
                        </div>
                    </div>
                </div>
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Cor (Cascata):</p>
                    <div id="dd-mdf-cor" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-mdf-cor')">
                            <span id="title-mdf-cor" style="color: #2563eb; font-weight: bold;">Selecione as cores...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container">
                            <input type="text" class="search-dd" placeholder="🔍 Pesquisar...">
                            <ul id="list-mdf-cor"></ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-panel">
                <div class="table-responsive">
                    <table class="table-custom" id="table-mdf">
                        <thead>
                            <tr>
                                <th>Insumo</th>
                                <th>Cor / Detalhe</th>
                                <th style="text-align: center;">Local</th>
                                <th style="text-align: center;">Qtd</th>
                                <th style="text-align: right;">Valor Un.</th>
                                <th style="text-align: right;">Valor Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(dados.mdf && dados.mdf.length > 0) { %>
                                <% dados.mdf.forEach(function(item) { %>
                                    <tr class="data-row" data-insumo="<%= item.insumo %>" data-cor="<%= item.cor %>" data-local="<%= item.local %>" data-qtd="<%= item.quantidade %>" data-valor="<%= item.valorUnitario %>">
                                        <td style="font-weight: 600;"><%= item.insumo %></td>
                                        <td><span style="background: #f1f5f9; padding: 4px 8px; border-radius: 4px; font-size: 0.85rem;"><%= item.cor %></span></td>
                                        <td style="text-align: center;">
                                            <span class="badge-local-<%= item.local.toLowerCase() %>"><%= item.local %></span>
                                        </td>
                                        <td style="text-align: center; font-weight: 700; color: #2563eb;"><%= item.quantidade %></td>
                                        <td style="text-align: right;" class="v-un">R$ <%= item.valorUnitario %></td>
                                        <td style="text-align: right; color: #059669; font-weight: bold;" class="v-total"></td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ABA 2: FERRAGENS -->
        <div id="tab-ferragens" class="tab-content">
            <!-- Estrutura simplificada dos paineis de filtro mantida... -->
            <div class="filter-panel">
                <div style="flex: 1; max-width: 400px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Filtrar por Insumo:</p>
                    <div id="dd-ferragens-insumo" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-ferragens-insumo')">
                            <span id="title-ferragens-insumo" style="color: #2563eb; font-weight: bold;">Selecione os insumos...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-ferragens-insumo"></ul></div>
                    </div>
                </div>
            </div>
            <div class="card-panel">
                <div class="table-responsive">
                    <table class="table-custom" id="table-ferragens">
                        <thead>
                            <tr>
                                <th>Insumo</th><th>Medida</th><th style="text-align: center;">Qtd</th><th style="text-align: right;">Valor Un.</th><th style="text-align: right;">Valor Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(dados.ferragens && dados.ferragens.length > 0) { dados.ferragens.forEach(function(item) { %>
                                <tr class="data-row" data-insumo="<%= item.insumo %>" data-qtd="<%= item.quantidade %>" data-valor="<%= item.valorUnitario %>">
                                    <td style="font-weight: 600;"><%= item.insumo %></td><td><%= item.medida || '-' %></td>
                                    <td style="text-align: center; font-weight: 700; color: #2563eb;"><%= item.quantidade %></td>
                                    <td style="text-align: right;" class="v-un"><%= item.valorUnitario %></td><td style="text-align: right; color: #059669; font-weight: bold;" class="v-total"></td>
                                </tr>
                            <% }); } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ABA 3: LIMPEZA -->
        <div id="tab-limpeza" class="tab-content">
            <div class="filter-panel">
                <div style="flex: 1; max-width: 400px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Filtrar por Insumo:</p>
                    <div id="dd-limpeza-insumo" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-limpeza-insumo')"><span id="title-limpeza-insumo" style="color: #2563eb; font-weight: bold;">Selecione os insumos...</span><i class="fas fa-chevron-down"></i></div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-limpeza-insumo"></ul></div>
                    </div>
                </div>
            </div>
            <div class="card-panel">
                <div class="table-responsive">
                    <table class="table-custom" id="table-limpeza">
                        <thead>
                            <tr><th>Insumo</th><th>Medida</th><th style="text-align: center;">Qtd</th><th style="text-align: right;">Valor Un.</th><th style="text-align: right;">Valor Total</th></tr>
                        </thead>
                        <tbody>
                            <% if(dados.limpeza && dados.limpeza.length > 0) { dados.limpeza.forEach(function(item) { %>
                                <tr class="data-row" data-insumo="<%= item.insumo %>" data-qtd="<%= item.quantidade %>" data-valor="<%= item.valorUnitario %>">
                                    <td style="font-weight: 600;"><%= item.insumo %></td><td><%= item.medida || '-' %></td>
                                    <td style="text-align: center; font-weight: 700; color: #2563eb;"><%= item.quantidade %></td>
                                    <td style="text-align: right;" class="v-un"><%= item.valorUnitario %></td><td style="text-align: right; color: #059669; font-weight: bold;" class="v-total"></td>
                                </tr>
                            <% }); } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ABA 4: EPI's -->
        <div id="tab-epis" class="tab-content">
            <div class="filter-panel">
                <div style="flex: 1; max-width: 400px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Filtrar por Insumo:</p>
                    <div id="dd-epis-insumo" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-epis-insumo')"><span id="title-epis-insumo" style="color: #2563eb; font-weight: bold;">Selecione os insumos...</span><i class="fas fa-chevron-down"></i></div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-epis-insumo"></ul></div>
                    </div>
                </div>
            </div>
            <div class="card-panel">
                <div class="table-responsive">
                    <table class="table-custom" id="table-epis">
                        <thead>
                            <tr><th>Insumo</th><th>Medida</th><th style="text-align: center;">Qtd</th><th style="text-align: right;">Valor Un.</th><th style="text-align: right;">Valor Total</th></tr>
                        </thead>
                        <tbody>
                            <% if(dados.epis && dados.epis.length > 0) { dados.epis.forEach(function(item) { %>
                                <tr class="data-row" data-insumo="<%= item.insumo %>" data-qtd="<%= item.quantidade %>" data-valor="<%= item.valorUnitario %>">
                                    <td style="font-weight: 600;"><%= item.insumo %></td><td><%= item.medida || '-' %></td>
                                    <td style="text-align: center; font-weight: 700; color: #2563eb;"><%= item.quantidade %></td>
                                    <td style="text-align: right;" class="v-un"><%= item.valorUnitario %></td><td style="text-align: right; color: #059669; font-weight: bold;" class="v-total"></td>
                                </tr>
                            <% }); } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- ABA 5: MAQUINÁRIO -->
        <div id="tab-maquinario" class="tab-content">
            <div class="filter-panel">
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Máquina:</p>
                    <div id="dd-maq-maquina" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-maq-maquina')">
                            <span id="title-maq-maquina" style="color: #2563eb; font-weight: bold;">Selecione...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-maq-maquina"></ul></div>
                    </div>
                </div>
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Marca:</p>
                    <div id="dd-maq-marca" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-maq-marca')">
                            <span id="title-maq-marca" style="color: #2563eb; font-weight: bold;">Selecione...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-maq-marca"></ul></div>
                    </div>
                </div>
                <div style="flex: 1; min-width: 250px;">
                    <p style="font-weight: bold; margin-bottom: 8px; color: #0f172a;">Status:</p>
                    <div id="dd-maq-status" class="dropdown-check-list">
                        <div class="anchor" onclick="toggleDropdown('dd-maq-status')">
                            <span id="title-maq-status" style="color: #2563eb; font-weight: bold;">Selecione...</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                        <div class="items-container"><input type="text" class="search-dd" placeholder="🔍 Pesquisar..."><ul id="list-maq-status"></ul></div>
                    </div>
                </div>
            </div>

            <div class="card-panel">
                <div class="table-responsive">
                    <table class="table-custom" id="table-maquinario">
                        <thead>
                            <tr>
                                <th>Máquina</th>
                                <th>Marca</th>
                                <th>Status</th>
                                <th style="text-align: center;">Quantidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(dados.maquinario && dados.maquinario.length > 0) { %>
                                <% dados.maquinario.forEach(function(item) { %>
                                    <tr class="data-row" data-maquina="<%= item.maquina %>" data-marca="<%= item.marca %>" data-status="<%= item.status %>" data-qtd="<%= item.quantidade %>" data-valor="0">
                                        <td style="font-weight: 600;"><%= item.maquina %></td>
                                        <td><%= item.marca %></td>
                                        <td><span style="background: #f1f5f9; padding: 4px 8px; border-radius: 4px; font-size: 0.85rem;"><%= item.status %></span></td>
                                        <td style="text-align: center; font-weight: 700; color: #2563eb; font-size: 1.1rem;"><%= item.quantidade %></td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <script>
        let currentTab = 'mdf';

        function parseBRL(valStr) {
            if (!valStr) return 0;
            let str = valStr.toString().replace('R$', '').trim();
            if (str.includes('.') && str.includes(',')) {
                str = str.replace(/\./g, '').replace(',', '.');
            } else if (str.includes(',')) {
                str = str.replace(',', '.');
            }
            return parseFloat(str) || 0;
        }

        function formatBRL(num) {
            return num.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function initTables() {
            document.querySelectorAll('.data-row').forEach(row => {
                const qtd = parseFloat(row.dataset.qtd) || 0;
                const valorUn = parseBRL(row.dataset.valor);
                const total = qtd * valorUn;
                row.dataset.total = total; 
                
                const totalCell = row.querySelector('.v-total');
                if (totalCell) totalCell.textContent = formatBRL(total);

                const unCell = row.querySelector('.v-un');
                if (unCell && !unCell.textContent.includes('R$')) {
                    unCell.textContent = formatBRL(valorUn);
                }
            });
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
            
            document.getElementById('tab-' + tabId).classList.add('active');
            event.currentTarget.classList.add('active');
            currentTab = tabId;
            updateSummary();
        }

        function updateSummary() {
            let totalQtd = 0;
            let totalValor = 0;

            const visibleRows = document.querySelectorAll(`#table-${currentTab} .data-row`);
            visibleRows.forEach(row => {
                if (row.style.display !== 'none') {
                    totalQtd += parseFloat(row.dataset.qtd) || 0;
                    totalValor += parseFloat(row.dataset.total) || 0;
                }
            });

            document.getElementById('resumoQtd').textContent = totalQtd;
            
            // Ocultar valor monetário se for a aba de maquinário
            if(currentTab === 'maquinario') {
                document.getElementById('resumoValor').parentElement.parentElement.style.display = 'none';
            } else {
                document.getElementById('resumoValor').parentElement.parentElement.style.display = 'flex';
                document.getElementById('resumoValor').textContent = formatBRL(totalValor);
            }
        }

        function toggleDropdown(id) { document.getElementById(id).classList.toggle('visible'); }

        document.addEventListener('click', e => {
            document.querySelectorAll('.dropdown-check-list').forEach(el => {
                if (!el.contains(e.target)) el.classList.remove('visible');
            });
        });

        document.querySelectorAll('.search-dd').forEach(input => {
            input.addEventListener('input', e => {
                const term = e.target.value.toLowerCase();
                const list = e.target.nextElementSibling;
                list.querySelectorAll('li').forEach(li => {
                    const label = li.querySelector('label').textContent.toLowerCase();
                    li.style.display = label.includes(term) ? 'flex' : 'none';
                });
            });
        });

        function populateDropdown(ulId, items, checkboxClass, onChangeCallback) {
            const ul = document.getElementById(ulId);
            const currentlyChecked = Array.from(document.querySelectorAll(`.${checkboxClass}:checked`)).map(cb => cb.value);
            
            ul.innerHTML = '';
            items.forEach(item => {
                const isChecked = currentlyChecked.includes(item) ? 'checked' : '';
                const cleanId = item.replace(/[^a-zA-Z0-9]/g, '');
                const li = document.createElement('li');
                li.innerHTML = `
                    <input type="checkbox" class="${checkboxClass}" value="${item}" id="chk_${ulId}_${cleanId}" ${isChecked}>
                    <label for="chk_${ulId}_${cleanId}" style="cursor: pointer; width: 100%; margin: 0;">${item}</label>
                `;
                ul.appendChild(li);
            });

            document.querySelectorAll(`.${checkboxClass}`).forEach(cb => cb.addEventListener('change', onChangeCallback));
        }

        function buildFilters() {
            // --- MDF (Local + Insumo -> Cor) ---
            const mdfRows = Array.from(document.querySelectorAll('#table-mdf .data-row'));
            const locaisMdf = [...new Set(mdfRows.map(r => r.dataset.local))].sort();
            const insumosMdf = [...new Set(mdfRows.map(r => r.dataset.insumo))].sort();
            
            populateDropdown('list-mdf-local', locaisMdf, 'chk-mdf-local', onMdfDependencyChange);
            populateDropdown('list-mdf-insumo', insumosMdf, 'chk-mdf-ins', onMdfDependencyChange);
            
            onMdfDependencyChange();

            function onMdfDependencyChange() {
                const cLoc = Array.from(document.querySelectorAll('.chk-mdf-local:checked')).map(c => c.value);
                const cIns = Array.from(document.querySelectorAll('.chk-mdf-ins:checked')).map(c => c.value);
                
                document.getElementById('title-mdf-local').textContent = cLoc.length > 0 ? `${cLoc.length} selecionados` : 'Selecione os locais...';
                document.getElementById('title-mdf-insumo').textContent = cIns.length > 0 ? `${cIns.length} selecionados` : 'Selecione os insumos...';
                
                const availableCores = new Set();
                mdfRows.forEach(row => {
                    const matchL = cLoc.length === 0 || cLoc.includes(row.dataset.local);
                    const matchI = cIns.length === 0 || cIns.includes(row.dataset.insumo);
                    if (matchL && matchI) availableCores.add(row.dataset.cor);
                });

                populateDropdown('list-mdf-cor', [...availableCores].sort(), 'chk-mdf-cor', applyMdfTableFilters);
                applyMdfTableFilters();
            }

            function applyMdfTableFilters() {
                const cLoc = Array.from(document.querySelectorAll('.chk-mdf-local:checked')).map(c => c.value);
                const cIns = Array.from(document.querySelectorAll('.chk-mdf-ins:checked')).map(c => c.value);
                const cCor = Array.from(document.querySelectorAll('.chk-mdf-cor:checked')).map(c => c.value);
                
                document.getElementById('title-mdf-cor').textContent = cCor.length > 0 ? `${cCor.length} selecionadas` : 'Selecione as cores...';
                
                mdfRows.forEach(row => {
                    const mL = cLoc.length === 0 || cLoc.includes(row.dataset.local);
                    const mI = cIns.length === 0 || cIns.includes(row.dataset.insumo);
                    const mC = cCor.length === 0 || cCor.includes(row.dataset.cor);
                    row.style.display = (mL && mI && mC) ? '' : 'none';
                });
                updateSummary();
            }

            // --- MAQUINÁRIO ---
            const maqRows = Array.from(document.querySelectorAll('#table-maquinario .data-row'));
            const maquinas = [...new Set(maqRows.map(r => r.dataset.maquina))].sort();
            const marcas = [...new Set(maqRows.map(r => r.dataset.marca))].sort();
            const statusList = [...new Set(maqRows.map(r => r.dataset.status))].sort();

            populateDropdown('list-maq-maquina', maquinas, 'chk-maq-maq', applyMaqFilters);
            populateDropdown('list-maq-marca', marcas, 'chk-maq-mar', applyMaqFilters);
            populateDropdown('list-maq-status', statusList, 'chk-maq-sta', applyMaqFilters);

            function applyMaqFilters() {
                const cMaq = Array.from(document.querySelectorAll('.chk-maq-maq:checked')).map(c=>c.value);
                const cMar = Array.from(document.querySelectorAll('.chk-maq-mar:checked')).map(c=>c.value);
                const cSta = Array.from(document.querySelectorAll('.chk-maq-sta:checked')).map(c=>c.value);

                document.getElementById('title-maq-maquina').textContent = cMaq.length > 0 ? `${cMaq.length} selecionadas` : 'Selecione...';
                document.getElementById('title-maq-marca').textContent = cMar.length > 0 ? `${cMar.length} selecionadas` : 'Selecione...';
                document.getElementById('title-maq-status').textContent = cSta.length > 0 ? `${cSta.length} selecionados` : 'Selecione...';

                maqRows.forEach(row => {
                    const mM = cMaq.length === 0 || cMaq.includes(row.dataset.maquina);
                    const mMar = cMar.length === 0 || cMar.includes(row.dataset.marca);
                    const mS = cSta.length === 0 || cSta.includes(row.dataset.status);
                    row.style.display = (mM && mMar && mS) ? '' : 'none';
                });
                updateSummary();
            }

            // --- OUTRAS ABAS ---
            setupSimpleTab('ferragens');
            setupSimpleTab('limpeza');
            setupSimpleTab('epis');
        }

        function setupSimpleTab(tabName) {
            const rows = Array.from(document.querySelectorAll(`#table-${tabName} .data-row`));
            const insumos = [...new Set(rows.map(r => r.dataset.insumo))].sort();
            
            populateDropdown(`list-${tabName}-insumo`, insumos, `chk-${tabName}-ins`, () => {
                const checked = Array.from(document.querySelectorAll(`.chk-${tabName}-ins:checked`)).map(c => c.value);
                document.getElementById(`title-${tabName}-insumo`).textContent = checked.length > 0 ? `${checked.length} selecionados` : 'Selecione os insumos...';
                rows.forEach(row => {
                    row.style.display = (checked.length === 0 || checked.includes(row.dataset.insumo)) ? '' : 'none';
                });
                updateSummary();
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initTables();
            buildFilters();
            updateSummary();
        });
    </script>
</body>
</html>