<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Balanço Geral - Controle de Insumos</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .card-financeiro { padding: 25px; border-radius: 12px; color: white; display: flex; flex-direction: column; justify-content: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .card-financeiro h3 { font-size: 1.1rem; opacity: 0.9; margin-bottom: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
        .card-financeiro h2 { font-size: 2.2rem; font-weight: 700; }
        
        .bg-estoque { background: linear-gradient(135deg, #0ea5e9, #0284c7); }
        .bg-solicitado { background: linear-gradient(135deg, #f59e0b, #d97706); }
        .bg-enviado { background: linear-gradient(135deg, #10b981, #059669); }

        .card-panel { background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); border: 1px solid #e2e8f0; margin-top: 30px; display: flex; flex-direction: column; overflow: hidden; }
        
        /* Estilos atualizados para o Efeito Sanfona no Cabeçalho */
        .card-header-custom { background: #1e293b; color: white; padding: 18px 24px; font-weight: bold; font-size: 1.1rem; display: flex; align-items: center; justify-content: space-between; }
        .section-title-accordion { cursor: pointer; transition: filter 0.2s; }
        .section-title-accordion:hover { filter: brightness(1.1); }
        
        .search-container { padding: 15px 20px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; position: relative; }
        .search-input { width: 100%; padding: 10px 10px 10px 35px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; font-size: 0.95rem; }
        .search-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
        .search-icon { position: absolute; left: 32px; top: 26px; color: #94a3b8; }

        .table-responsive { width: 100%; max-height: 50vh; overflow-y: auto; }
        .table-custom { width: 100%; border-collapse: collapse; }
        .table-custom th, .table-custom td { padding: 14px 20px; border-bottom: 1px solid #e2e8f0; text-align: left; vertical-align: middle; }
        .table-custom th { background-color: #f1f5f9; color: #475569; font-weight: bold; font-size: 0.85rem; text-transform: uppercase; position: sticky; top: 0; z-index: 10; box-shadow: 0 2px 0 0 #cbd5e1; }
        .table-custom tbody tr:hover { background-color: #f8fafc; }
    </style>
</head>
<body>
    <%- include('../partials/sidebar') %>
    
    <main class="main-content">
        <div class="page-header" style="margin-bottom: 25px;">
            <div>
                <h1>Balanço Geral Financeiro</h1>
                <p style="color: #64748b; font-size: 1.1rem; margin-top: 5px;">Visão consolidada dos custos de insumos na UGTR.</p>
            </div>
        </div>

        <!-- Indicadores Globais -->
        <div class="grid-cards">
            <div class="card-financeiro bg-estoque">
                <h3><i class="fas fa-boxes"></i> Capital em Estoque</h3>
                <h2><%= Number(dados.valorTotalEstoque).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h2>
            </div>
            
            <div class="card-financeiro bg-solicitado">
                <h3><i class="fas fa-clipboard-list"></i> Solicitado (Demanda)</h3>
                <h2><%= Number(dados.valorTotalSolicitado).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h2>
            </div>

            <div class="card-financeiro bg-enviado">
                <h3><i class="fas fa-truck-loading"></i> Enviado (Consumido)</h3>
                <h2><%= Number(dados.valorTotalEnviado).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %></h2>
            </div>
        </div>

        <!-- TELINHA DETALHADA 1: COMPOSIÇÃO DO ESTOQUE -->
        <div class="card-panel">
            <!-- Cabeçalho Acordeão -->
            <div class="card-header-custom section-title-accordion" style="background: #0284c7;" onclick="toggleSanfona('containerEstoque', 'iconeEstoque')">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-search-dollar"></i> <span>Detalhamento do Capital em Estoque</span>
                </div>
                <i id="iconeEstoque" class="fas fa-chevron-up"></i>
            </div>
            
            <!-- Container que será escondido/exibido -->
            <div id="containerEstoque">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="pesquisaEstoque" class="search-input" onkeyup="filtrarTabela('pesquisaEstoque', 'tabelaEstoque')" placeholder="Pesquisar insumo armazenado...">
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="tabelaEstoque">
                        <thead>
                            <tr>
                                <th style="width: 40%;">Insumo</th>
                                <th style="text-align: center; width: 15%;">Quantidade</th>
                                <th style="text-align: right; width: 20%;">Custo Unitário</th>
                                <th style="text-align: right; width: 25%;">Valor Total em Estoque</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% dados.estoqueDetalhado.forEach(item => { %>
                                <tr data-busca="<%= item.nome.toLowerCase() %>">
                                    <td>
                                        <strong style="color: #0f172a;"><%= item.nome %></strong>
                                    </td>
                                    <td style="text-align: center; font-weight: bold; color: #475569;">
                                        <%= item.qtd %> <span style="font-size: 0.8rem; font-weight: normal;"><%= item.unidade %></span>
                                    </td>
                                    <td style="text-align: right; color: #64748b;">
                                        <%= Number(item.valor_unitario).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                                    </td>
                                    <td style="text-align: right; color: #0284c7; font-weight: bold; font-size: 1.05rem;">
                                        <%= Number(item.valor_total).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TELINHA DETALHADA 2: CUSTO POR PROCESSO -->
        <div class="card-panel">
            <!-- Cabeçalho Acordeão -->
            <div class="card-header-custom section-title-accordion" onclick="toggleSanfona('containerProcesso', 'iconeProcesso')">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-chart-bar"></i> <span>Custo Detalhado por Processo (Demandas)</span>
                </div>
                <i id="iconeProcesso" class="fas fa-chevron-up"></i>
            </div>

            <!-- Container que será escondido/exibido -->
            <div id="containerProcesso">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="pesquisaProcesso" class="search-input" onkeyup="filtrarTabela('pesquisaProcesso', 'tabelaProcesso')" placeholder="Pesquisar processo pelo nome ou número...">
                </div>

                <div class="table-responsive">
                    <table class="table-custom" id="tabelaProcesso">
                        <thead>
                            <tr>
                                <th style="width: 35%;">Processo</th>
                                <th style="text-align: center; width: 15%;">Status</th>
                                <th style="text-align: right; width: 16%;">Custo Solicitado</th>
                                <th style="text-align: right; width: 16%;">Custo Enviado</th>
                                <th style="text-align: right; width: 18%;">Saldo (A Enviar)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% dados.balancoProcessos.forEach(p => { %>
                                <tr data-busca="<%= p.nome.toLowerCase() %> <%= p.numero %>">
                                    <td>
                                        <strong style="color: #0f172a; font-size: 1.05rem;"><%= p.nome %></strong><br>
                                        <span style="color: #64748b; font-size: 0.85rem; font-weight: bold;">#<%= p.numero %></span>
                                    </td>
                                    <td style="text-align: center;">
                                        <span class="badge" style="background:#f1f5f9; color:#334155;"><%= p.status %></span>
                                    </td>
                                    <td style="text-align: right; color: #f59e0b; font-weight: bold;">
                                        <%= Number(p.valor_solicitado).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                                    </td>
                                    <td style="text-align: right; color: #10b981; font-weight: bold;">
                                        <%= Number(p.valor_enviado).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                                    </td>
                                    <td style="text-align: right; color: #475569; font-weight: bold;">
                                        <%= Number(p.saldo_a_enviar).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- SCRIPTS -->
    <script>
        // Função de Pesquisa
        function filtrarTabela(inputId, tabelaId) {
            const input = document.getElementById(inputId).value.toLowerCase();
            const linhas = document.querySelectorAll(`#${tabelaId} tbody tr`);

            linhas.forEach(linha => {
                const textoBusca = linha.getAttribute('data-busca');
                if (textoBusca) {
                    if (textoBusca.includes(input)) {
                        linha.style.display = ""; 
                    } else {
                        linha.style.display = "none"; 
                    }
                }
            });
        }

        // Função do Acordeão (Sanfona)
        function toggleSanfona(containerId, iconeId) {
            const container = document.getElementById(containerId);
            const icone = document.getElementById(iconeId);
            
            if (container.style.display === "none") {
                container.style.display = "block";
                icone.classList.remove("fa-chevron-down");
                icone.classList.add("fa-chevron-up");
            } else {
                container.style.display = "none";
                icone.classList.remove("fa-chevron-up");
                icone.classList.add("fa-chevron-down");
            }
        }
    </script>
</body>
</html>