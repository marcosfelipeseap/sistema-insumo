<aside class="sidebar">
    <div class="logo-area">
        <img src="/img/logo.png" alt="Logo" class="logo" style="width: 45px; height: auto; border-radius: 4px;">
        <h2 class="brand">Controle de Insumos</h2>
    </div>
    
    <div style="padding: 0 20px 20px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 10px;">
        <div style="font-size:11px; color:#94a3b8; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:5px;">Logado como</div>
        <div style="font-weight:bold; color:white; display:flex; justify-content:space-between; align-items:center;">
            <span><%= user ? user.username : 'Visitante' %></span>
            <span style="font-size:10px; color:#94a3b8;">(<%= user ? user.cargo : '' %>)</span>
        </div>
    </div>

    <nav class="nav-menu">
        <!-- BOTÃO ALMOXARIFADO SEDE (DESTACADO NO TOPO) -->
        <% if (user && user.cargo !== 'solicitante') { %>
            <div style="margin-bottom: 15px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px;">
                <a href="/almoxarifado" class="nav-item" style="background: #2563eb; color: white; font-weight: 700; border-radius: 6px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                    <i class="fas fa-warehouse" style="color: #93c5fd;"></i> Almoxarifado Sede (Marcenaria)
                </a>
            </div>
        <% } %>

        <!-- Solicitações: Visível apenas para Solicitante e Admin -->
        <% if (user && (user.cargo === 'solicitante' || user.cargo === 'admin')) { %>
            <a href="/processos/solicitacoes" class="nav-item"><i class="fas fa-clipboard-check"></i> Solicitações</a>
        <% } %>

        <!-- Processos & Demandas -->
        <% if (user && user.cargo !== 'Monitor') { %>
            <a href="/processos" class="nav-item"><i class="fas fa-folder-open"></i> Processos & Demandas</a>
        <% } %>
        
        <% if (user && user.cargo !== 'solicitante') { %>
            <a href="/estoque" class="nav-item"><i class="fas fa-boxes"></i> Almoxarifado</a>
            <a href="/estoque/historico" class="nav-item"><i class="fas fa-history"></i> Histórico de Estoque</a>
            <a href="/envios" class="nav-item"><i class="fas fa-truck-loading"></i> Envios para Produção</a>
            
            <% if (user.cargo !== 'Monitor') { %>
                <a href="/balanco" class="nav-item"><i class="fas fa-chart-pie"></i> Balanço Financeiro</a>
                <a href="/simulador" class="nav-item"><i class="fas fa-vial"></i> Simulador de Produção</a>
            <% } %>
        <% } %>
        
        <% if (user && user.cargo === 'admin') { %>
            <a href="/admin/usuarios" class="nav-item" style="border-top: 1px solid rgba(255,255,255,0.1); margin-top: 10px; padding-top: 10px;">
                <i class="fas fa-users-cog"></i> Gestão de Usuários
            </a>
        <% } %>
        
        <a href="/perfil" class="nav-item" style="border-top: 1px solid rgba(255,255,255,0.1); margin-top: 10px; padding-top: 10px;">
            <i class="fas fa-user-circle"></i> Meu Perfil
        </a>

        <a href="/logout" class="nav-item" style="color: #ef4444; margin-top: auto;">
            <i class="fas fa-sign-out-alt"></i> Sair
        </a>
    </nav>
</aside>